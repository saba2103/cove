<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_day_sheet_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:baselineAligned="false">

        <FrameLayout
            android:id="@+id/widget_hit_masthead"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="24"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_day_sheet_title" />

        <FrameLayout
            android:id="@+id/widget_hit_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_day_sheet_title" />

        <FrameLayout
            android:id="@+id/widget_hit_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_day_sheet_title" />

        <FrameLayout
            android:id="@+id/widget_hit_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_day_sheet_title" />

        <FrameLayout
            android:id="@+id/widget_hit_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="14"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_day_sheet_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="65"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/widget_hit_habit_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

                <FrameLayout
                    android:id="@+id/widget_hit_habit_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_day_sheet_title" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_hit_today_spend"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="35"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_day_sheet_title" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
