{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Cove design tokens. Source of truth. Authored at DEVICE scale (logical pixels / dp), not prototype px. Run `dart run tool/gen_tokens.dart` to regenerate lib/core/theme/cove_tokens.dart.",
  "$extensions": {
    "cove.scale": {
      "note": "Prototype is 300x682px of content. Device anchor 393dp (Pixel 6 is 411dp). Factor 1.3, snapped to multiples of four. Prototype numbers never appear in this file.",
      "factor": 1.3,
      "maxContentWidth": 420
    }
  },

  "surface": {
    "canvas": {"$type":"color","$value":{"dark":"#0B1F1E","light":"#F4EDE3"}},
    "card":   {"$type":"color","$value":{"dark":"#12302E","light":"#FFFCF8"}},
    "row":    {"$type":"color","$value":{"dark":"#0F2624","light":"#F8F3EC"}},
    "sheet":  {"$type":"color","$value":{"dark":"#12302E","light":"#FFFCF8"}},
    "scrim":  {"$type":"color","$value":{"dark":"#000000A6","light":"#1E332F7A"}}
  },

  "text": {
    "primary":   {"$type":"color","$value":{"dark":"#F3ECE2","light":"#1E332F"}},
    "secondary": {"$type":"color","$value":{"dark":"#B4B7B0","light":"#4B5B57"}},
    "tertiary":  {"$type":"color","$value":{"dark":"#909993","light":"#5D6B67"}},
    "onAccent":  {"$type":"color","$value":{"dark":"#0B1F1E","light":"#0B1F1E"}},
    "onPaper":   {"$type":"color","$value":{"dark":"#1E332F","light":"#1E332F"}}
  },

  "line": {
    "hairline": {"$type":"color","$value":{"dark":"#F3ECE212","light":"#1E332F14"}},
    "strong":   {"$type":"color","$value":{"dark":"#F3ECE224","light":"#1E332F29"}}
  },

  "accent": {
    "fill": {"$type":"color","$value":{"dark":"#D8B98C","light":"#A97C4F"}},
    "text": {"$type":"color","$value":{"dark":"#D8B98C","light":"#76532D"}},
    "tint": {"$type":"color","$value":{"dark":"#EAD3AC","light":"#A97C4F"}},
    "wash": {"$type":"color","$value":{"dark":"#D8B98C1F","light":"#A97C4F1F"}}
  },

  "status": {
    "alert":     {"$type":"color","$value":{"dark":"#C46D5E","light":"#B4523F"}, "$description":"Marks, bars, icons. Non-text, 3:1."},
    "alertText": {"$type":"color","$value":{"dark":"#D4806F","light":"#A8483A"}, "$description":"Alert words. 4.5:1."},
    "good":      {"$type":"color","$value":{"dark":"#8CBE9D","light":"#3E7753"}}
  },

  "money": {
    "more": {"$type":"color","$value":{"dark":"#D99B86","light":"#985A47"}, "$description":"Spending up. Never alone - always beside a + sign or a word."},
    "less": {"$type":"color","$value":{"dark":"#8CBE9D","light":"#3E7753"}}
  },

  "person": {
    "a":      {"$type":"gradient","$value":{"from":"#D2B38E","to":"#A47C51","angle":145}, "$description":"The home's CREATOR, keyed to home.createdBy - not to the viewer, so both phones agree. Lifted from #C8A274->#8C6A45 so the initial clears 4.5:1."},
    "aLabel": {"$type":"color","$value":"#0B1F1E", "$description":"Worst case across the gradient: 4.54:1."},
    "b":      {"$type":"gradient","$value":{"from":"#587166","to":"#2C3C37","angle":145}, "$description":"The home's JOINER. Deepened from #7E9A8E->#4D6A60 so a cream initial clears 4.5:1 - and so the two people read apart at a glance, one clearly light, one clearly dark."},
    "bLabel": {"$type":"color","$value":"#F3ECE2", "$description":"Worst case across the gradient: 4.51:1."},
    "both":   {"$type":"strokeGradient","$value":{"from":"#D2B38E","to":"#587166","angle":145,"width":"1.5dp"}, "$description":"UNFILLED - a shared thing is owned by neither, so it gets no fill. The ring blends the two people's colours instead of the old gold, which frees gold for one-per-screen."},
    "bothLabel": {"$type":"color","$value":{"dark":"#F3ECE2","light":"#1E332F"}, "$description":"The ampersand sits on the page surface, so it is text.primary."}
  },

  "paper": {
    "from":    {"$type":"color","$value":"#EDE3D0"},
    "via":     {"$type":"color","$value":"#E4D8C2"},
    "to":      {"$type":"color","$value":"#DED1B8"},
    "ink":     {"$type":"color","$value":"#1E332F"},
    "ink2":    {"$type":"color","$value":"#44534A"},
    "ink3":    {"$type":"color","$value":"#505C53"},
    "accent":  {"$type":"color","$value":"#76532D"},
    "rule":    {"$type":"color","$value":"#1E332F33"},
    "hairline":{"$type":"color","$value":"#1E332F1C"},
    "edge":    {"$type":"color","$value":{"dark":"#00000000","light":"#1E332F33"}, "$description":"Light mode only - paper on a cream ground is 1.1:1 without it."}
  },

  "slip": {
    "inkFrom":      {"$type":"color","$value":"#1A4541"},
    "inkVia":       {"$type":"color","$value":"#133734"},
    "inkTo":        {"$type":"color","$value":"#0E2A28"},
    "inkText3":     {"$type":"color","$value":"#A3ABA6","$description":"Tertiary text on ink; text.tertiary fails there at 3.63:1."},
    "inkAlertText": {"$type":"color","$value":"#DC988A","$description":"Alert words on ink; status.alertText fails at 3.61:1."},
    "inkMark":      {"$type":"color","$value":"#909993","$description":"Empty streak cells — non-text, 3.63:1 against a 3:1 floor."}
  },

  "category": {
    "travel":    {"$type":"color","$value":{"dark":"#E0C98A","light":"#8A6F2E"}},
    "groceries": {"$type":"color","$value":{"dark":"#D8B98C","light":"#7E5A2C"}},
    "health":    {"$type":"color","$value":{"dark":"#C46D5E","light":"#9C4335"}},
    "eatingOut": {"$type":"color","$value":{"dark":"#C9A0C4","light":"#7D4F78"}},
    "home":      {"$type":"color","$value":{"dark":"#A8C49B","light":"#4F7042"}},
    "pets":      {"$type":"color","$value":{"dark":"#8FC9B6","light":"#2F6D5B"}},
    "fuel":      {"$type":"color","$value":{"dark":"#8FB3C9","light":"#3A6079"}},
    "gifts":     {"$type":"color","$value":{"dark":"#B9A3D8","light":"#5C4788"}}
  },

  "space": {
    "xs":           {"$type":"dimension","$value":"4dp"},
    "sm":           {"$type":"dimension","$value":"8dp"},
    "md":           {"$type":"dimension","$value":"12dp"},
    "gutter":       {"$type":"dimension","$value":"20dp","$description":"Horizontal padding of every scroll container. Inner elements add none."},
    "lg":           {"$type":"dimension","$value":"24dp"},
    "section":      {"$type":"dimension","$value":"32dp"},
    "xl":           {"$type":"dimension","$value":"48dp"},
    "barClearance": {"$type":"dimension","$value":"112dp","$description":"Bottom padding on any page wearing the floating bar."},
    "hitPlate":     {"$type":"dimension","$value":"12dp","$description":"A row's horizontal padding; it bleeds out with an equal negative margin."}
  },

  "size": {
    "row":           {"$type":"dimension","$value":"52dp","$description":"Row HEIGHT is the token. Vertical padding is derived: (row - content) / 2."},
    "buttonRound":   {"$type":"dimension","$value":"40dp","$description":"The drawn circle. Every header action, back and add alike."},
    "hit":           {"$type":"dimension","$value":"48dp","$description":"Tappable area around the drawn button. Never smaller."},
    "avatarInline":  {"$type":"dimension","$value":"24dp"},
    "avatarRow":     {"$type":"dimension","$value":"28dp"},
    "avatarHeader":     {"$type":"dimension","$value":"32dp"},
    "avatarProfile":    {"$type":"dimension","$value":"64dp"},
    "compactThreshold": {"$type":"dimension","$value":"360dp","$description":"Viewport width below which the floating bar renders icons only and the metric grid collapses to a single column."},
    "maxContent":       {"$type":"dimension","$value":"420dp","$description":"Page content never exceeds this; centred on anything wider - the Fold's inner screen, tablets, web."}
  },

  "radius": {
    "inline":    {"$type":"dimension","$value":"20dp"},
    "card":      {"$type":"dimension","$value":"24dp"},
    "hero":      {"$type":"dimension","$value":"32dp"},
    "sheet":     {"$type":"dimension","$value":"40dp","$description":"Top corners of every bottom sheet."},
    "device":    {"$type":"dimension","$value":"48dp","$description":"Bottom corners of a sheet reaching the screen edge. A stand-in for the hardware corner - read it from the OS where you can."},
    "pill":      {"$type":"dimension","$value":"999dp"},
    "smoothing": {"$type":"number","$value":1.0,"$description":"Figma corner smoothing (100% squircle)."}
  },

  "type": {
    "familyDisplay": {"$type":"fontFamily","$value":"LibreBodoni","$description":"Display and ALL figures."},
    "familyUi":      {"$type":"fontFamily","$value":"PlusJakartaSans"},
    "title":      {"$type":"typography","$value":{"family":"display","size":28,"weight":500,"lineHeight":36,"letterSpacing":-0.01}},
    "greeting":   {"$type":"typography","$value":{"family":"display","size":36,"weight":400,"lineHeight":40,"letterSpacing":0}},
    "letter":     {"$type":"typography","$value":{"family":"display","size":21,"weight":400,"lineHeight":36,"letterSpacing":0}},
    "slipTitle":  {"$type":"typography","$value":{"family":"display","size":22,"weight":400,"lineHeight":28,"letterSpacing":-0.01}},
    "slipFigure": {"$type":"typography","$value":{"family":"display","size":32,"weight":500,"lineHeight":36,"letterSpacing":0}},
    "heroFigure": {"$type":"typography","$value":{"family":"display","size":40,"weight":400,"lineHeight":44,"letterSpacing":0}},
    "cardFigure": {"$type":"typography","$value":{"family":"display","size":28,"weight":400,"lineHeight":32,"letterSpacing":0}},
    "rowTitle":   {"$type":"typography","$value":{"family":"ui","size":15,"weight":500,"lineHeight":20,"letterSpacing":0}},
    "body":       {"$type":"typography","$value":{"family":"ui","size":15,"weight":400,"lineHeight":22,"letterSpacing":0}},
    "readout":    {"$type":"typography","$value":{"family":"ui","size":14,"weight":400,"lineHeight":18,"letterSpacing":0}},
    "rowSub":     {"$type":"typography","$value":{"family":"ui","size":12,"weight":400,"lineHeight":16,"letterSpacing":0}},
    "barLabel":   {"$type":"typography","$value":{"family":"ui","size":11,"weight":600,"lineHeight":14,"letterSpacing":0},"$description":"Floating bar seat label — mixed-case, zero tracking."},
    "capsPage":   {"$type":"typography","$value":{"family":"ui","size":12,"weight":700,"lineHeight":16,"letterSpacing":0.15,"upper":true},"$description":"A section label on the page."},
    "capsCard":   {"$type":"typography","$value":{"family":"ui","size":11,"weight":700,"lineHeight":14,"letterSpacing":0.14,"upper":true},"$description":"A label inside a card or object. Nothing in the app is smaller."},
    "capsSlip":   {"$type":"typography","$value":{"family":"ui","size":11,"weight":700,"lineHeight":14,"letterSpacing":0.18,"upper":true},"$description":"On paper only - the slips keep their own print scale."}
  },

  "elevation": {
    "paper": {"$type":"shadow","$value":[{"y":18,"blur":40,"color":"#0000004D"},{"y":3,"blur":7,"color":"#0000002E"}]},
    "bar":   {"$type":"shadow","$value":[{"y":8,"blur":32,"color":"#00000066"}]}
  },

  "motion": {
    "quick": {"$type":"duration","$value":140},
    "sheet": {"$type":"duration","$value":320},
    "easing":{"$type":"cubicBezier","$value":[0.2,0.0,0.0,1.0]}
  }
}
